# Public host
APP_DOMAIN=woodauction.id.vn
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# MySQL
MYSQL_DATABASE=woodcert_auction
MYSQL_USER=woodcert
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis and JWT
REDIS_PASSWORD=
JWT_SECRET_KEY=

# Generate two different BCrypt hashes and wrap each value in single quotes.
ADMIN_PASSWORD_HASH=
APPRAISER_PASSWORD_HASH=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail App Password must be entered without spaces.
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=woodcert/prod

# VNPay Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Fulfillment
FULFILLMENT_SHIPMENT_DEADLINE=PT72H
FULFILLMENT_SHIPMENT_DEADLINE_CRON=0 */1 * * * *
