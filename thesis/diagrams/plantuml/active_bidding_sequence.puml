@startuml
!include chapter-4-style.puml
title Trình tự đặt giá trong phiên ACTIVE
autonumber

actor "Người đặt giá" as Bidder
participant "BidController" as Controller
participant "BidServiceImpl" as Service
database "MySQL" as MySQL
participant "Redis Lua" as Lua
participant "AuctionBroadcastService" as Broadcast
participant "BidPersistenceService" as Persist
participant "STOMP clients" as Clients

Bidder -> Controller : POST /api/v1/bids
Controller -> Service : placeBid(userId, request)
Service -> MySQL : đọc AuctionSession và Product
MySQL --> Service : trạng thái, seller, cấu hình

alt Phiên không ACTIVE hoặc bidder là seller
  Service --> Controller : lỗi nghiệp vụ
  Controller --> Bidder : 4xx
else Qua kiểm tra sơ bộ
  Service -> Lua : execute(stateKey, biddersKey,\namount, now, anti-sniper, traceId)

  alt LOW / ENDED / NOT_REGISTERED / SELF_BID
    Lua --> Service : mã từ chối
    opt LOW hoặc ENDED
      Service -> Persist : cố gắng lưu bid bị từ chối
    end
    Service --> Controller : ánh xạ lỗi nghiệp vụ
    Controller --> Bidder : 4xx
  else OK
    Lua --> Service : newPrice, newEndTime, extendedBy
    opt Có gia hạn anti-sniper
      Service -> Lua : kéo dài TTL theo end time mới
    end
    Service -> Broadcast : broadcastNewBid(...)
    Broadcast -> Clients : NEW_BID

    group Ghi MySQL best-effort
      Service -> Persist : saveBid(..., VALID)
      Persist -> MySQL : transaction REQUIRES_NEW
      Service -> MySQL : updateRuntimeSnapshotIfNotStale(...)
      note right of Service
      Lỗi ở từng bước được ghi log;
      không đảo ngược bid Redis đã chấp nhận.
      end note
    end

    Service --> Controller : traceId, newPrice, newEndTime
    Controller --> Bidder : 200 OK
  end
end
@enduml
