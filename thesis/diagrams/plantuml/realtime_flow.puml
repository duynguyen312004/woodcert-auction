@startuml
title Luồng đặt giá REST và broadcast thời gian thực

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor White

actor "Buyer A" as BuyerA
participant "REST API\nBidService" as Backend
database "Redis\nLua script" as Redis
participant "Spring simple broker\n/topic/auctions/{id}" as Broker
actor "Buyer B" as BuyerB
database "MySQL\nBid audit / snapshot" as MySQL

BuyerA -> Broker : Subscribe
BuyerB -> Broker : Subscribe

BuyerA -> Backend : POST /api/v1/bids\nJWT + auctionSessionId + bidAmount
Backend -> Backend : Kiểm tra trạng thái DB,\nquyền và seller tự đặt giá
Backend -> Redis : Chạy Lua nguyên tử
Redis --> Backend : resultCode, current/new price,\nendTime, extendedByMs

alt Lượt đặt hợp lệ (OK)
    Backend -> Backend : Gia hạn TTL nếu anti-sniper
    Backend -> Broker : Broadcast NEW_BID
    Broker --> BuyerA : Giá mới, bidder alias,\nendTime, bidTraceId
    Broker --> BuyerB : Giá mới, bidder alias,\nendTime, bidTraceId
    Backend -> MySQL : Lưu bid hợp lệ (best-effort)
    Backend -> MySQL : Đồng bộ snapshot nếu không stale\n(best-effort)
    Backend --> BuyerA : HTTP 200 + giá/endTime mới
else Hết thời gian hoặc giá quá thấp
    Backend -> MySQL : Lưu bid bị từ chối
    Backend --> BuyerA : HTTP lỗi nghiệp vụ
else Chưa đăng ký hoặc đang giữ giá cao nhất
    Backend --> BuyerA : HTTP lỗi nghiệp vụ\nkhông broadcast
end

note over Broker
  Broker là simple broker nhúng trong Spring,
  không phải một dịch vụ message broker độc lập.
end note
@enduml
