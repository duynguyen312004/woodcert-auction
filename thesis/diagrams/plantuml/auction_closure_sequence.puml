@startuml
!include chapter-4-style.puml
title Trình tự đóng phiên, quyết toán cọc và tạo đơn
autonumber

participant "AuctionSessionScheduler" as Scheduler
participant "AuctionSessionLifecycleWorker" as Worker
participant "AuctionRedisService" as Redis
database "MySQL" as MySQL
participant "AuctionSettlementService" as Settlement
participant "ParticipantSettlementService" as ParticipantSettlement
participant "WalletService" as Wallet
participant "OrderService" as Order
participant "AuctionBroadcastService" as Broadcast

Scheduler -> MySQL : tìm session ACTIVE đến hạn
MySQL --> Scheduler : danh sách sessionId

loop Mỗi sessionId
  Scheduler -> Worker : finalizeDueSession(id, now)
  Worker -> MySQL : khóa AuctionSession FOR UPDATE
  Worker -> Redis : getSessionState(id)

  alt Redis endTime còn ở tương lai
    Redis --> Worker : snapshot đã được gia hạn
    Worker -> MySQL : đồng bộ snapshot và giữ ACTIVE
    Worker --> Scheduler : Optional.empty()
  else Đã đến hạn
    alt Có state Redis
      Redis --> Worker : giá, bidder, traceId, endTime
    else Mất state Redis
      Redis --> Worker : rỗng
      Worker -> MySQL : đọc snapshot và bid VALID cao nhất
    end
    Worker -> MySQL : commit ENDED_SUCCESS hoặc ENDED_FAILED\nvà trạng thái bán của sản phẩm
    Worker --> Scheduler : CloseResult

    Scheduler -> Settlement : settleFinalizedSession(result)
    Settlement -> MySQL : lấy participant còn FROZEN
    loop Từng participant
      Settlement -> ParticipantSettlement : settleOneParticipant(id, result)
      ParticipantSettlement -> Wallet : capture cọc winner\nhoặc release cọc loser
      Wallet -> MySQL : transaction độc lập
    end

    alt Phiên thành công và không còn FROZEN
      Settlement -> Order : createFromSource(AUCTION, sessionId)
      Order -> MySQL : tạo duy nhất order PENDING_PAYMENT
    end

    Settlement -> Redis : dọn state theo best-effort
    Scheduler -> Broadcast : SESSION_ENDED
  end
end

note over Scheduler,Order
Scheduler sửa chữa chạy định kỳ để xử lý participant còn sót
hoặc tạo lại order nếu bước hậu phiên trước đó thất bại.
end note
@enduml
