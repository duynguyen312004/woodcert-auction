@startuml
!include chapter-4-style.puml
title Thiết kế rút gọn của mô-đun auction
left to right direction
hide empty members

package "API" {
  class AuctionController
  class BidController
}

package "Quản lý phiên" {
  interface AuctionService
  class AuctionServiceImpl
  class AuctionCommandService
  class AuctionQueryService
  class AuctionPolicy
}

package "Đặt giá runtime" {
  interface BidService
  class BidServiceImpl {
    +placeBid(bidderId, request)
  }
  class BidLuaScript
  class AuctionRedisService
  class AuctionBroadcastService
  class BidPersistenceService
}

package "Vòng đời và quyết toán" {
  class AuctionSessionScheduler {
    +activateDueSessions()
    +closeDueSessions()
    +repairFinalizedSessionsWithFrozenDeposits()
  }
  class AuctionSessionLifecycleWorker {
    +activateDueSession(id, now)
    +finalizeDueSession(id, now)
  }
  class AuctionSettlementService
  class AuctionParticipantSettlementService
  class AuctionOrderSourceAdapter
}

package "Dữ liệu" {
  class AuctionSession
  class AuctionParticipant
  class Bid
  interface AuctionSessionRepository
  interface AuctionParticipantRepository
  interface BidRepository
}

package "Mô-đun khác" {
  interface WalletService
  interface OrderService
  class Product
}

AuctionController --> AuctionService
AuctionService <|.. AuctionServiceImpl
AuctionServiceImpl --> AuctionCommandService
AuctionServiceImpl --> AuctionQueryService
AuctionCommandService --> AuctionPolicy

BidController --> BidService
BidService <|.. BidServiceImpl
BidServiceImpl --> AuctionSessionRepository
BidServiceImpl --> BidLuaScript
BidServiceImpl --> AuctionRedisService
BidServiceImpl --> AuctionBroadcastService
BidServiceImpl --> BidPersistenceService

AuctionSessionScheduler --> AuctionSessionLifecycleWorker
AuctionSessionScheduler --> AuctionSettlementService
AuctionSessionLifecycleWorker --> AuctionSessionRepository
AuctionSessionLifecycleWorker --> BidRepository
AuctionSessionLifecycleWorker --> AuctionRedisService
AuctionSettlementService --> AuctionParticipantRepository
AuctionSettlementService --> AuctionParticipantSettlementService
AuctionSettlementService --> OrderService
AuctionParticipantSettlementService --> WalletService
AuctionOrderSourceAdapter ..> OrderService

AuctionSessionRepository ..> AuctionSession
AuctionParticipantRepository ..> AuctionParticipant
BidRepository ..> Bid
AuctionSession --> Product
AuctionParticipant --> AuctionSession
Bid --> AuctionSession

note bottom of BidServiceImpl
Redis/Lua là ranh giới chấp nhận bid.
Lưu Bid và đồng bộ snapshot MySQL là best-effort.
end note

note bottom of AuctionSessionLifecycleWorker
Chốt trạng thái terminal trước;
quyết toán participant được điều phối sau commit.
end note
@enduml
