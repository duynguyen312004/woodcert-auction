@startuml
!include chapter-4-style.puml
title Kiến trúc thành phần tổng quan của WoodCert Auction
top to bottom direction

actor "Người dùng" as User
rectangle "Trình duyệt" as Browser {
  component "React SPA" as SPA
  component "STOMP/SockJS client" as WsClient
}

component "Nginx production\nHTTPS và định tuyến" as HostNginx #E8EEF3

together {
  component "Nginx frontend\nTệp tĩnh và SPA fallback" as FrontNginx
  rectangle "Backend Spring Boot\nĐơn khối phân mô-đun" as Backend #F7F2E8 {
    component "REST API và Security" as Rest
    component "8 mô-đun nghiệp vụ" as Features
    component "Scheduler và\nSTOMP simple broker" as Runtime
  }
}

together {
  database "MySQL 8\nDữ liệu bền vững,\ntrạng thái terminal" as MySQL
  database "Redis 7.4\nRuntime phiên ACTIVE,\nLua nguyên tử" as Redis
}

together {
  cloud "Cloudinary\nMedia" as Cloudinary
  cloud "VNPay Sandbox\nNạp tiền thử nghiệm" as VNPay
  cloud "SMTP\nEmail hệ thống" as SMTP
}

User --> Browser
Browser --> HostNginx : HTTPS
HostNginx --> FrontNginx : /
HostNginx --> Rest : /api/v1
HostNginx --> Runtime : /ws-auction
FrontNginx --> SPA : index.html, assets

Rest --> Features
Runtime --> Features : scheduler
Features --> Runtime : sự kiện STOMP
Runtime --> WsClient : NEW_BID,\nSESSION_ENDED

Features --> MySQL : JPA / SQL
Features --> Redis : Redis protocol / Lua
Features --> Cloudinary : ký upload,\nxác minh media
Features --> VNPay : tạo URL,\nxác minh phản hồi
Features --> SMTP : gửi email

SPA ..> Cloudinary : upload trực tiếp
SPA ..> VNPay : redirect

HostNginx -[hidden]down-> FrontNginx
FrontNginx -[hidden]right-> Backend
MySQL -[hidden]right-> Redis
Cloudinary -[hidden]right-> VNPay
VNPay -[hidden]right-> SMTP

note right of Backend
Các mô-đun nằm trong cùng một tiến trình Java.
Không có giao tiếp mạng nội bộ giữa các mô-đun.
end note

note bottom of Redis
Redis là nguồn trạng thái runtime khi phiên ACTIVE;
MySQL quản lý dữ liệu bền vững và trạng thái kết thúc.
end note
@enduml
