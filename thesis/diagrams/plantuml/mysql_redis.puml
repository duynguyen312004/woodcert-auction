@startuml
title Phối hợp MySQL và Redis trong vòng đời phiên đấu giá

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam backgroundColor White

database "MySQL\nDữ liệu bền vững" as MySQL
participant "AuctionSessionScheduler" as Scheduler
database "Redis\nRuntime ACTIVE" as Redis
participant "BidService" as Bid
participant "AuctionSessionLifecycleWorker" as Lifecycle
participant "AuctionSettlementService" as Settlement
participant "OrderService" as Order

== Kích hoạt ==
Scheduler -> MySQL : Đọc phiên WAITING đến hạn\nvà participant có cọc FROZEN
Scheduler -> Redis : Khởi tạo state + bidders
Scheduler -> MySQL : Chuyển phiên sang ACTIVE

== Đặt giá ==
Bid -> Redis : Lua validate/update nguyên tử
Redis --> Bid : resultCode, price, endTime,\nextendedByMs
alt OK
    Bid -> Bid : Broadcast NEW_BID
    Bid -> MySQL : Lưu bid và snapshot\n(best-effort)
else LOW hoặc ENDED
    Bid -> MySQL : Lưu bid bị từ chối
end

== Chốt phiên ==
Scheduler -> Lifecycle : finalizeDueSession
Lifecycle -> Redis : Đọc snapshot cuối
alt Redis còn dữ liệu
    Redis --> Lifecycle : Giá, bidder, bidTraceId, endTime
else Redis thiếu dữ liệu
    Lifecycle -> MySQL : Khôi phục từ snapshot DB\nvà bid audit
end
Lifecycle -> MySQL : Ghi ENDED_SUCCESS\nhoặc ENDED_FAILED
Lifecycle --> Scheduler : CloseResult

== Quyết toán ==
Scheduler -> Settlement : settleFinalizedSession
Settlement -> MySQL : Hoàn/thu tiền cọc\nvà ghi doanh thu
alt ENDED_SUCCESS
    Settlement -> Order : Tạo order idempotent
    Order -> MySQL : Lưu PENDING_PAYMENT
end
Settlement -> Redis : Xóa state và bidders\n(best-effort)

note over Redis
  Redis là nguồn quyết định khi phiên ACTIVE.
  MySQL giữ hồ sơ bền vững và trạng thái kết thúc chính thức.
end note
@enduml
