@startuml
title Quy trình sau đấu giá: thanh toán, giao nhận và tranh chấp

skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor White
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor Black
skinparam activity {
    BackgroundColor White
    BorderColor Black
    FontColor Black
    FontSize 13
}
skinparam swimlane {
    BorderColor Black
    TitleBackgroundColor White
    TitleFontColor Black
}

|Người mua (Buyer)|
start
:Chọn địa chỉ giao hàng;
:Thanh toán phần tiền còn lại;

|WoodCert Auction|
if (Thanh toán đúng hạn?) then ([Có])
    :Ghi nhận thanh toán\nphần còn lại từ ví;
    :Chuyển đơn hàng sang PAID;
    :Tạo thông tin giao nhận chờ\nNgười bán xác nhận;
else ([Không])
    :Tác vụ nền theo lịch\nhủy đơn quá hạn;
    :Phân bổ tiền cọc theo chính sách;
    stop
endif

|Người bán (Seller)|
:Xác nhận đã gửi hoặc bàn giao\nvà cập nhật thông tin vận chuyển;

|WoodCert Auction|
if (Thao tác được thực hiện\ntrong 72 giờ?) then ([Có])
    :Chuyển giao nhận sang SHIPPED;
else ([Không (Quá hạn)])
    :Tác vụ nền theo lịch\ntự động hủy đơn;
    :Hoàn trả tiền cọc và phần\nđã thanh toán cho Người mua;
    :Chuyển trạng thái sản phẩm sang AVAILABLE;
    stop
endif

|Người mua (Buyer)|
if (Phát sinh tranh chấp?) then ([Có])
    :Tải ít nhất một ảnh bằng chứng;
    :Mở hồ sơ tranh chấp;

    |WoodCert Auction|
    :Đánh dấu đơn hàng DISPUTED;

    |Người mua (Buyer)|
    :Gửi thông điệp và tệp\nbằng chứng nếu có;

    |Người bán (Seller)|
    :Gửi thông điệp và tệp\nbằng chứng nếu có;

    |Quản trị viên (Admin)|
    :Xem hồ sơ và đánh dấu đang xem xét;
    :Ra quyết định tranh chấp;
    note right
      Hệ thống hiện chưa hỗ trợ
      hoàn tiền một phần.
    end note

    |WoodCert Auction|
    if (Kết quả giải quyết\ntranh chấp?) then ([Người mua thắng])
        :Hoàn tiền cho Người mua;
        :Hủy đơn và giao nhận;
        :Đánh dấu sản phẩm RETURNED;
    else ([Người bán thắng])
        :Hoàn tất đơn hàng;
        :Giải ngân cho Người bán;
    endif
    :Đóng hồ sơ tranh chấp;
    stop
else ([Không])
    if (Người mua xác nhận\nđã nhận hàng?) then ([Có])
        :Hoàn tất đơn hàng;
        :Giải ngân cho Người bán;
        stop
    else ([Chưa])
        |WoodCert Auction|
        :Chờ hết thời hạn\ntự hoàn tất 168 giờ;
        :Tự động hoàn tất đơn hàng;
        :Giải ngân cho Người bán;
        stop
    endif
endif
@enduml
