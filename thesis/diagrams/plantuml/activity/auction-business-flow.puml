@startuml
title Quy trình từ tạo sản phẩm đến kết thúc phiên đấu giá

skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor White
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor Black
skinparam activity {
    BackgroundColor White
    BorderColor Black
    FontColor Black
    FontSize 13
}
skinparam swimlane {
    BorderColor Black
    TitleBackgroundColor White
    TitleFontColor Black
}

|Seller|
start
:Tạo sản phẩm nháp,\nbổ sung mô tả và ảnh;
:Gửi yêu cầu kiểm định;

|WoodCert Auction|
:Thu phí kiểm định;
:Chuyển sản phẩm sang\nPENDING_APPRAISAL;

|Seller|
:Gửi hàng vật lý tới\nđơn vị kiểm định;

|Appraiser|
:Nhận xử lý yêu cầu\n(claim có thời hạn);
:Kiểm tra trực tiếp hàng hóa\nvà chụp ảnh tại hiện trường;
:Lập báo cáo kiểm định;
note right
  Ảnh chứng minh có thể được
  tải lên nhưng không bắt buộc.
end note

|WoodCert Auction|
:Tạo mã hồ sơ và dấu vân tay SHA-256;
if (Kết quả xác thực?) then ([Đạt])
    :Chuyển sản phẩm sang APPRAISED;
else ([Không đạt])
    :Chuyển sản phẩm sang REJECTED;
    |Seller|
    :Xem kết quả và lý do từ chối;
    stop
endif

|Seller|
:Tạo phiên đấu giá từ\nsản phẩm APPRAISED;

|WoodCert Auction|
:Kiểm tra giá, tiền cọc,\nthời gian và xung đột phiên;
:Lưu phiên WAITING;
:Scheduler kích hoạt phiên ACTIVE;

|Bidder/Buyer|
:Đăng ký tham gia;

|WoodCert Auction|
:Kiểm tra điều kiện và\nphong tỏa tiền đặt cọc;

while (Phiên ACTIVE và còn thời gian?) is ([Có])
    |Bidder/Buyer|
    :Gửi giá đặt qua REST API;
    |WoodCert Auction|
    :Redis/Lua kiểm tra và\ncập nhật nguyên tử;
    if (Lượt đặt hợp lệ?) then ([Có])
        :Broadcast NEW_BID;
        :Lưu bid và snapshot MySQL\n(best-effort);
    else ([Không])
        :Trả lỗi nghiệp vụ;
    endif
endwhile ([Hết thời gian])

|WoodCert Auction|
:Lifecycle worker chốt\nENDED_SUCCESS hoặc ENDED_FAILED;
if (ENDED_SUCCESS?) then ([Có])
    :Quyết toán tiền cọc;
    :Tạo đơn hàng PENDING_PAYMENT;
else ([Không])
    :Hoàn tiền cọc hợp lệ;
endif
stop
@enduml
