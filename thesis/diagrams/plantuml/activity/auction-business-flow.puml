@startuml
title Quy trình từ tạo sản phẩm đến kết thúc phiên đấu giá

skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam backgroundColor White
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor Black
skinparam activity {
    BackgroundColor White
    BorderColor Black
    FontColor Black
    FontSize 13
}
skinparam swimlane {
    BorderColor Black
    TitleBackgroundColor White
    TitleFontColor Black
}

|Người bán (Seller)|
start
:Tạo sản phẩm nháp,\nbổ sung mô tả và ảnh;
:Gửi yêu cầu thẩm định;

|WoodCert Auction|
:Thu phí thẩm định;
:Chuyển sản phẩm sang\nPENDING_APPRAISAL;

|Người bán (Seller)|
:Gửi hiện vật tới\nđơn vị thẩm định;
note right
  Việc gửi, tiếp nhận và kiểm tra
  hiện vật diễn ra ngoài phần mềm.
end note

|Thẩm định viên (Appraiser)|
:Tiếp nhận quyền xử lý\nyêu cầu có thời hạn;

|WoodCert Auction|
:Chuyển sản phẩm sang\nUNDER_APPRAISAL;

|Thẩm định viên (Appraiser)|
:Kiểm tra trực tiếp hiện vật;
:Lập báo cáo thẩm định;
note right
  Ảnh chứng minh có thể được
  tải lên nhưng không bắt buộc.
end note

|WoodCert Auction|
:Tạo mã chứng thư điện tử và\nlưu mã băm SHA-256;
if (Kết quả thẩm định\nđạt yêu cầu?) then ([Đạt])
    :Chuyển sản phẩm sang APPRAISED;
else ([Không đạt])
    :Chuyển sản phẩm sang REJECTED;
    |Người bán (Seller)|
    :Xem kết quả và lý do từ chối;
    stop
endif

|Người bán (Seller)|
:Tạo phiên đấu giá từ sản phẩm\nAPPRAISED và AVAILABLE;

|WoodCert Auction|
:Kiểm tra giá, tiền cọc,\nthời gian và xung đột phiên;
:Lưu phiên WAITING;

|Người tham gia (Bidder)|
:Đăng ký tham gia khi phiên WAITING\nhoặc ACTIVE còn hiệu lực;

|WoodCert Auction|
:Kiểm tra điều kiện và\nphong tỏa tiền đặt cọc;
note right
  Đăng ký được mở từ giai đoạn WAITING
  và tiếp tục trong ACTIVE khi phiên còn thời gian.
end note
:Đến thời điểm bắt đầu, tác vụ nền\nchuyển phiên sang ACTIVE;

while (Phiên ACTIVE và còn thời gian?) is ([Có])
    |Người tham gia (Bidder)|
    :Gửi lượt đặt giá;
    |WoodCert Auction|
    :Kiểm tra thời gian, tư cách\ntham gia và mức giá;
    if (Lượt đặt hợp lệ?) then ([Có])
        :Cập nhật giá hiện tại và thông báo\nkết quả lượt đặt giá;
        :Gia hạn thời điểm kết thúc nếu lượt đặt giá\nthuộc cửa sổ chống đặt giá sát giờ;
    else ([Không])
        :Trả lỗi nghiệp vụ;
    endif
endwhile ([Hết thời gian])

|WoodCert Auction|
:Kết thúc phiên và\nxác định kết quả;
if (Có người thắng hợp lệ?) then ([Có])
    :Quyết toán tiền cọc;
    :Tạo đơn hàng chờ thanh toán;
else ([Không])
    :Hoàn tiền cọc hợp lệ;
endif
stop
@enduml
